# ─── Engine API (most important) ────────────────────────────────────
# Base URL of the Smart Wheel Engine HTTP API (engine_api.py). The cockpit,
# the /api/engine and /api/portfolio/* proxies, and the /api/market and
# /api/watchlist quote fallbacks all reach it server-side. Default targets a
# local engine on the standard port; set this only if the engine runs on
# another host/port.
ENGINE_API_URL=http://localhost:8787

# ─── Optional API Keys ──────────────────────────────────────────────
# Finnhub: realtime quotes for /api/market and the terminal watchlist.
# Without a key those routes fall back to the engine's EOD close.
# Get one at: https://finnhub.io/register
FINNHUB_API_KEY=

# ─── Ollama Configuration ──────────────────────────────────────────
# URL where Ollama is running (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Model used by the terminal research chat, /api/chat (default: qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b

# ─── Engine Ollama Models (set in terminal, not here) ──────────────
# These are read by engine_api.py (Python), not the Next.js app.
# Set them in your terminal before running: python engine_api.py
#
#   $env:OLLAMA_HEAVY_MODEL = "qwen2.5:72b"   # PowerShell
#   export OLLAMA_HEAVY_MODEL=qwen2.5:72b      # bash/zsh
#
# OLLAMA_HEAVY_MODEL=qwen2.5:72b   # Used for full AI trade memos
# OLLAMA_FAST_MODEL=qwen2.5:32b    # Used for quick summaries
